{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "postmodernism",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "TELEGRAM_BOT_USERNAME": "auth_mebot"
  },
  "kv_namespaces": [
    {
      "binding": "LOCATIONS",
      "id": "49353f753238403b914d2a3dbaf761b9"
    }
  ]
}
