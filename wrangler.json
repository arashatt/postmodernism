{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "postmodernism",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "TELEGRAM_BOT_USERNAME": ""
  }
}
